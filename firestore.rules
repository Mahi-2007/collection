rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Your admin user's UID: Firebase console -> Authentication -> Users -> "User UID" column
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'PASTE_YOUR_ADMIN_UID_HERE';
    }

    match /coins/{coinId} {
      // Visitors may read only published coins. The admin can read everything (including drafts).
      allow read: if resource.data.status == 'published' || isAdmin();
      // Only the admin can add, change or delete.
      allow write: if isAdmin();
    }

    // Site wording (the admin page's "Site text" tab). Public to read, admin-only to write.
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
